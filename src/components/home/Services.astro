---
interface ServiceItem {
  title: string;
  description: string;
  icon: string; // emoji atau text singkat, ganti dengan icon library kalau perlu
  size?: 'wide' | 'narrow'; // wide = span 2 kolom
}

interface Props {
  title: string;
  items: ServiceItem[]; // sebaiknya persis 8 item
}
const { title, items } = Astro.props;
---

<section class="py-5 bg-light">
  <div class="container">
    <h2 class="font-heading fw-bold text-center mb-5">{title}</h2>
    <div class="kk-bento">
      {items.map((item) => (
        <div class={`kk-bento-item ${item.size === 'wide' ? 'kk-bento-wide' : ''} p-4 rounded-4 bg-white shadow-sm`}>
          <div class="fs-2 mb-2">{item.icon}</div>
          <h3 class="font-heading h5 fw-bold mb-2">{item.title}</h3>
          <p class="text-muted small mb-0">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .kk-bento {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .kk-bento-wide {
    grid-column: span 2;
  }
  @media (max-width: 768px) {
    .kk-bento {
      grid-template-columns: repeat(2, 1fr);
    }
    .kk-bento-wide {
      grid-column: span 2;
    }
  }
</style>

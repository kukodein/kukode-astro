---
import type { ArticleRow, Locale } from '../../lib/sheets';
import { localizedHref } from '../../lib/i18n-utils';

interface Props {
  eyebrow: string;
  title: string;
  locale: Locale;
  articles: ArticleRow[]; // sudah di-slice 3 teratas oleh halaman pemanggil
  viewAllLabel: string;
}
const { eyebrow, title, locale, articles, viewAllLabel } = Astro.props;
---

<section id="blog" class="kk-section">
  <div class="container">
    <div class="d-flex justify-content-between align-items-end mb-4">
      <div><p class="kk-eyebrow mb-2">{eyebrow}</p><h2 class="mb-0">{title}</h2></div>
      <a href={localizedHref(locale, '/article/')} class="btn btn-outline-kk btn-sm">{viewAllLabel}</a>
    </div>
    <div class="row g-3">
      {articles.map((article) => (
        <div class="col-md-4">
          <div class="kk-card p-2">
            <a href={localizedHref(locale, `/article/${article.slug}`)} class="text-decoration-none text-reset">
              {article.image_url && (
                <img src={article.image_url} alt={article.title} class="img-fluid rounded-3 w-100" />
              )}
              <div class="m-2">
                <time datetime={article.published_date} class="text-muted-kk small">{article.published_date}</time>
                <h3 class="h6 font-heading fw-bold mt-1">{article.title}</h3>
                <p class="text-muted small">{article.excerpt}</p>
              </div>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
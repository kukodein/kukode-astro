---
interface Testimonial {
  name: string;
  role: string;
  quote: string;
  avatar?: string;
  featured?: boolean; // kalau true, card ini span 2 kolom
}
interface Props {
  title: string;
  items: Testimonial[]; // sebaiknya persis 4 item, salah satu featured:true
}
const { title, items } = Astro.props;
---

<section class="py-5 bg-light">
  <div class="container">
    <h2 class="font-heading fw-bold text-center mb-5">{title}</h2>
    <div class="row g-4">
      {items.map((t) => (
        <div class={t.featured ? 'col-lg-8' : 'col-lg-4'}>
          <div class="bg-white rounded-4 shadow-sm p-4 h-100">
            <p class={`mb-4 ${t.featured ? 'fs-5' : ''}`}>&ldquo;{t.quote}&rdquo;</p>
            <div class="d-flex align-items-center gap-3">
              {t.avatar && <img src={t.avatar} alt={t.name} class="rounded-circle" width="48" height="48" loading="lazy" />}
              <div>
                <p class="fw-bold mb-0">{t.name}</p>
                <p class="text-muted small mb-0">{t.role}</p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

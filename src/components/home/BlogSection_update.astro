---
import type { ArticleRow, Locale } from '../../lib/sheets';
import { localizedHref } from '../../lib/i18n-utils';

interface Props {
  title: string;
  locale: Locale;
  articles: ArticleRow[]; // sudah di-slice 3 teratas oleh halaman pemanggil
  viewAllLabel: string;
}
const { title, locale, articles, viewAllLabel } = Astro.props;
---

<section class="py-5">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-5">
      <h2 class="font-heading fw-bold mb-0">{title}</h2>
      <a href={localizedHref(locale, '/article/')} class="btn btn-sm btn-outline-primary">{viewAllLabel}</a>
    </div>
    <div class="row g-4">
      {articles.map((article) => (
        <div class="col-md-4">
          <a href={localizedHref(locale, `/article/${article.slug}`)} class="text-decoration-none text-dark">
            {article.featured_image && (
              <img src={article.featured_image} alt={article.title} class="img-fluid rounded-4 mb-3 w-100" />
            )}
            <time datetime={article.published_date} class="text-muted small d-block mb-1">
              {article.published_date}
            </time>
            <h3 class="font-heading h6 fw-bold">{article.title}</h3>
            <p class="text-muted small">{article.excerpt}</p>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

---
interface Props {
  title: string;
  text: string;
  ctaLabel: string;
  ctaHref: string;
}
const { title, text, ctaLabel, ctaHref } = Astro.props;
---

<section class="py-5">
  <div class="container">
    <div class="row justify-content-center text-center">
      <div class="col-lg-8">
        <h2 class="font-heading fw-bold mb-3">{title}</h2>
        <p class="text-muted fs-5 mb-4">{text}</p>
        <a href={ctaHref} class="btn btn-outline-primary px-4">{ctaLabel}</a>
      </div>
    </div>
  </div>
</section>

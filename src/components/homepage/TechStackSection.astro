---
interface TechCategory {
  name: string;
  items: string[];
}
interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  categories: TechCategory[];
}
const { eyebrow, title, subtitle, categories } = Astro.props;
---

<section id="stack" class="kk-section kk-gradient-alt">
  <div class="container">
    <div class="row g-4 align-items-start">
      <div class="col-lg-4">
        <div class="kk-eyebrow mb-2">{eyebrow}</div>
        <h2 class="mb-3">{title}</h2>
        <p>{subtitle}</p>
      </div>
      <div class="col-lg-8">
        <div class="row g-4">
          {categories.map((cat) => (
            <div class="col-md-4">
              <div class="text-uppercase text-secondary fw-bold fs-7 mb-2">{cat.name}</div>
              <div class="d-flex flex-wrap gap-2">
                {cat.items.map((item) => <span class="tp-pill">{item}</span>)}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>


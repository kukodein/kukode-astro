---
import JsonLd from '../JsonLd.astro';

interface FaqItem {
  question: string;
  answer: string;
}
interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  ctaLabel: string;
  ctaHref: string;
  items: FaqItem[];
  /** If true, generates FAQPage JSON-LD schema */
  withSchema?: boolean;
}
const { eyebrow, title, subtitle, ctaLabel, ctaHref, items, withSchema = false } = Astro.props;

const faqPageSchema = withSchema
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: items.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    }
  : null;
---

<section id="faq" class="kk-section bg-surface">
  {faqPageSchema && <JsonLd data={faqPageSchema} />}
  <div class="container">
    <div class="row g-4">
      <div class="col-lg-4">
        <div class="kk-eyebrow mb-2">{eyebrow}</div>
        <h2 class="mb-3">{title}</h2>
        <p class="mb-4">{subtitle}</p>
        <a href={ctaHref} class="btn btn-primary" target="_blank"> {ctaLabel}</a>
      </div>
      <div class="col-lg-8">
        {items.map((item) => (
          <div class="kk-faq-item"><button class="kk-faq-q">{item.question} <span class="kk-faq-chevron">+</span></button><div class="kk-faq-a"><div class="kk-faq-a-inner">{item.answer}</div></div></div>
        ))}
      </div>
    </div>
  </div>
</section>


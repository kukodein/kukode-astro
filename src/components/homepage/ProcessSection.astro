---
interface StepItem {
  number: number;
  tag: string;
  title: string;
  description: string;
}
interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  steps: StepItem[];
}
const { eyebrow, title, subtitle, steps } = Astro.props;
---

<section id="process" class="kk-section kk-gradient-alt">
  <div class="container">
    <div class="text-center mb-5"><p class="kk-eyebrow mb-2">{eyebrow}</p><h2>{title}</h2><p class="mx-auto" style="max-width:560px;">{subtitle}</p></div>
    <div class="row g-3">
      {steps.map((step) => (
        <div class="col-md-4 col-lg">
          <div class="kk-card p-4 kk-step-card">
            <span class="kk-step-tag d-none">{step.tag}</span>
            <div class="kk-step-circle" style="margin:0 0 0.9rem;">{step.number}</div>
            <h3 class="h6 font-heading fw-bold mb-1">{step.title}</h3>
            <p class="text-muted-kk small mb-0">{step.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>


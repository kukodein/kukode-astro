---
// Komponen ini isinya SEMUA <meta>/<link> yang berkaitan dengan SEO.
// Dipakai di <head> BaseLayout, jadi tidak perlu diulang manual tiap halaman.
//
// Catatan: LinkedIn TIDAK punya tag terpisah seperti Twitter Card — LinkedIn generate
// preview link dari Open Graph tags yang sama (og:title, og:description, og:image).
// Jadi tidak ada "linkedin:card" di sini, itu bukan standar yang ada.

interface Props {
  locale: 'en' | 'id';
  title: string;
  description?: string;
  image?: string; // absolute URL kalau ada (og:image butuh absolute, bukan relative)
  type?: 'website' | 'article';
  publishedDate?: string; // format YYYY-MM-DD, hanya untuk type="article"
  modifiedDate?: string; // format YYYY-MM-DD, hanya untuk type="article"
  path: string; // path halaman ini TANPA domain, contoh: "/about/" atau "/id/tentang/" — dipakai untuk canonical
  enPath?: string; // path versi EN TANPA domain TANPA prefix, mis. "/article/foo" — untuk hreflang
  idPath?: string; // path versi ID TANPA domain TANPA prefix "/id", mis. "/article/artikel-foo" — untuk hreflang
  robots?: string; // default "index, follow" — override kalau suatu saat butuh noindex halaman tertentu
}

const {
  locale,
  title,
  description,
  image,
  type = 'website',
  publishedDate,
  modifiedDate,
  path,
  enPath,
  idPath,
  robots = 'index, follow',
} = Astro.props;

const siteUrl = Astro.site?.origin ?? 'https://domain.com';
const canonicalUrl = `${siteUrl}${path}`;
const ogImage = image ?? `${siteUrl}/og-default.jpg`; // fallback kalau halaman tidak punya gambar sendiri
const siteName = 'Kukode';
const twitterHandle = '@kukode'; // ganti sesuai handle asli Anda

function absoluteEnUrl(p: string): string {
  return `${siteUrl}${p}`;
}
function absoluteIdUrl(p: string): string {
  return p === '/' ? `${siteUrl}/id/` : `${siteUrl}/id${p}`;
}
---

{/* Canonical URL */}
<link rel="canonical" href={canonicalUrl} />

{/* hreflang — enPath/idPath terpisah karena slug artikel bisa beda per bahasa */}
{enPath && <link rel="alternate" hreflang="en" href={absoluteEnUrl(enPath)} />}
{idPath && <link rel="alternate" hreflang="id" href={absoluteIdUrl(idPath)} />}
{enPath && <link rel="alternate" hreflang="x-default" href={absoluteEnUrl(enPath)} />}

{/* Robots meta tag */}
<meta name="robots" content={robots} />

{/* Open Graph (dipakai juga oleh LinkedIn, WhatsApp, Facebook preview) */}
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={locale === 'en' ? 'en_US' : 'id_ID'} />

{/* Twitter/X Card */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={twitterHandle} />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={ogImage} />

{/* Date published/modified — hanya relevan untuk artikel */}
{type === 'article' && publishedDate && (
  <meta property="article:published_time" content={new Date(publishedDate).toISOString()} />
)}
{type === 'article' && modifiedDate && (
  <meta property="article:modified_time" content={new Date(modifiedDate).toISOString()} />
)}

{/* JSON-LD structured data untuk artikel — bantu Google tampilkan tanggal di hasil pencarian */}
{type === 'article' && publishedDate && (
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description: description,
      image: ogImage,
      datePublished: new Date(publishedDate).toISOString(),
      dateModified: new Date(modifiedDate ?? publishedDate).toISOString(),
    })}
  />
)}

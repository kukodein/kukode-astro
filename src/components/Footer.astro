---
// Footer — dipakai global di semua halaman. Konten hardcoded (bukan dari Sheets),
// konsisten dengan keputusan homepage sections yang hardcoded.
//
// CATATAN PERBAIKAN: file HTML asli punya 2 kolom "Social" yang identik (kemungkinan
// copy-paste tidak sengaja) - saya gabungkan jadi 1 kolom Social, supaya kembali ke
// 4 kolom sesuai brief awal (Brand, Navigation, Social, Contact).
import { getSettings, type Locale } from '../lib/sheets';

interface Props {
  locale: Locale;
}

const settings = await getSettings();
const { locale } = Astro.props;
const homePath = locale === 'en' ? '/' : '/id/';

const navLabel = locale === 'en' ? 'Navigation' : 'Navigasi';
const socialLabel = locale === 'en' ? 'Social' : 'Sosial';
const contactLabel = locale === 'en' ? 'Contact' : 'Kontak';
const brandBlurb =
  locale === 'en'
    ? "Web development studio helping growing businesses build fast, modern websites."
    : 'Studio jasa pembuatan website yang membantu bisnis berkembang membangun website modern dan cepat.';

const navItems =
  locale === 'en'
    ? [
        { href: `${homePath}#services`, label: 'Services' },
        { href: `${homePath}#portfolio`, label: 'Portfolio' },
        { href: `${homePath}#pricing`, label: 'Pricing' },
        { href: '/about/', label: 'About' },
      ]
    : [
        { href: `${homePath}#services`, label: 'Layanan' },
        { href: `${homePath}#portfolio`, label: 'Portofolio' },
        { href: `${homePath}#pricing`, label: 'Harga' },
        { href: '/id/tentang/', label: 'Tentang' },
      ];

const copyright = 
  locale === 'en'
    ? settings.copyright_text_en
    : locale === 'id'
    ? settings.copyright_text_id
    : '© 2026 Kukode Digital Technology · All rights reserved.';
---

<footer class="kk-section kk-gradient-alt pb-4" style="border-top:1px solid var(--bs-border-color);">
  <div class="container">
    <div class="row g-4">
      <div class="col-12 col-md">
        <p class="fw-bold font-heading mb-2 d-none">Kukode</p>
        <img class="mb-3 d-show-light d-none-dark" width="120px" src="/image/Logo-Kukode-Landscape.png" alt="Kukode">
        <img class="mb-3 d-show-dark d-none-light" width="120px" src="/image/Logo-Kukode-Landscape-White.png" alt="Kukode">
        <p class="text-muted-kk small">{brandBlurb}</p>
        <p class="text-muted-kk small"><strong>Head Quarter</strong><br>Yogyakarta, Indonesia</p>
        <div class="d-flex gap-2">
          <a class="kk-icon-circle kk-icon-circle-small link-primary" target="_blank" aria-label="Icon link Social Media Instagram" href="https://www.instagram.com/kukode.id" rel="noopener noreferrer"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d="M13.028 2c1.125.003 1.696.009 2.189.023l.194.007c.224.008.445.018.712.03c1.064.05 1.79.218 2.427.465c.66.254 1.216.598 1.772 1.153a4.9 4.9 0 0 1 1.153 1.772c.247.637.415 1.363.465 2.428c.012.266.022.487.03.712l.006.194c.015.492.021 1.063.023 2.188l.001.746v1.31a79 79 0 0 1-.023 2.188l-.006.194c-.008.225-.018.446-.03.712c-.05 1.065-.22 1.79-.466 2.428a4.9 4.9 0 0 1-1.153 1.772a4.9 4.9 0 0 1-1.772 1.153c-.637.247-1.363.415-2.427.465l-.712.03l-.194.006c-.493.014-1.064.021-2.189.023l-.746.001h-1.309a78 78 0 0 1-2.189-.023l-.194-.006a63 63 0 0 1-.712-.031c-1.064-.05-1.79-.218-2.428-.465a4.9 4.9 0 0 1-1.771-1.153a4.9 4.9 0 0 1-1.154-1.772c-.247-.637-.415-1.363-.465-2.428l-.03-.712l-.005-.194A79 79 0 0 1 2 13.028v-2.056a79 79 0 0 1 .022-2.188l.007-.194c.008-.225.018-.446.03-.712c.05-1.065.218-1.79.465-2.428A4.9 4.9 0 0 1 3.68 3.678a4.9 4.9 0 0 1 1.77-1.153c.638-.247 1.363-.415 2.428-.465c.266-.012.488-.022.712-.03l.194-.006a79 79 0 0 1 2.188-.023zM12 7a5 5 0 1 0 0 10a5 5 0 0 0 0-10m0 2a3 3 0 1 1 .001 6a3 3 0 0 1 0-6m5.25-3.5a1.25 1.25 0 0 0 0 2.5a1.25 1.25 0 0 0 0-2.5"/></svg></a>
          <a class="kk-icon-circle kk-icon-circle-small link-primary" target="_blank" aria-label="Icon link Social Media Facebook" href="https://www.facebook.com/kukodein" rel="noopener noreferrer"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d="M12.001 2c-5.523 0-10 4.477-10 10c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89c1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.344 21.129 22 16.992 22 12c0-5.523-4.477-10-10-10"/></svg></a>
          <a class="kk-icon-circle kk-icon-circle-small link-primary" target="_blank" aria-label="Icon link Social Media YouTube" href="https://www.youtube.com/@kukode_id" rel="noopener noreferrer"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d="M12.244 4c.534.003 1.87.016 3.29.073l.504.022c1.429.067 2.857.183 3.566.38c.945.266 1.687 1.04 1.938 2.022c.4 1.56.45 4.602.456 5.339l.001.152v.174c-.007.737-.057 3.78-.457 5.339c-.254.985-.997 1.76-1.938 2.022c-.709.197-2.137.313-3.566.38l-.504.023c-1.42.056-2.756.07-3.29.072l-.235.001h-.255c-1.13-.007-5.856-.058-7.36-.476c-.944-.266-1.687-1.04-1.938-2.022c-.4-1.56-.45-4.602-.456-5.339v-.326c.006-.737.056-3.78.456-5.339c.254-.985.997-1.76 1.939-2.021c1.503-.419 6.23-.47 7.36-.476zM9.999 8.5v7l6-3.5z"/></svg></a>
          <a class="kk-icon-circle kk-icon-circle-small link-primary" target="_blank" aria-label="Icon link Social Media WhatsApp" href="https://wa.me/62853293353541" rel="noopener noreferrer"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d="M12.001 2c5.523 0 10 4.477 10 10s-4.477 10-10 10a9.95 9.95 0 0 1-5.03-1.355L2.005 22l1.352-4.968A9.95 9.95 0 0 1 2.001 12c0-5.523 4.477-10 10-10M8.593 7.3l-.2.008a1 1 0 0 0-.372.1a1.3 1.3 0 0 0-.294.228c-.12.113-.188.211-.261.306A2.73 2.73 0 0 0 6.9 9.62c.002.49.13.967.33 1.413c.409.902 1.082 1.857 1.97 2.742c.214.213.424.427.65.626a9.45 9.45 0 0 0 3.84 2.046l.568.087c.185.01.37-.004.556-.013a2 2 0 0 0 .833-.231a5 5 0 0 0 .383-.22q.001.002.125-.09c.135-.1.218-.171.33-.288q.126-.13.21-.302c.078-.163.156-.474.188-.733c.024-.198.017-.306.014-.373c-.004-.107-.093-.218-.19-.265l-.582-.261s-.87-.379-1.402-.621a.5.5 0 0 0-.176-.041a.48.48 0 0 0-.378.127c-.005-.002-.072.055-.795.931a.35.35 0 0 1-.368.13a1.4 1.4 0 0 1-.191-.066c-.124-.052-.167-.072-.252-.108a6 6 0 0 1-1.575-1.003c-.126-.11-.243-.23-.363-.346a6.3 6.3 0 0 1-1.02-1.268l-.059-.095a1 1 0 0 1-.102-.205c-.038-.147.061-.265.061-.265s.243-.266.356-.41c.11-.14.203-.276.263-.373c.118-.19.155-.385.093-.536q-.42-1.026-.868-2.041c-.059-.134-.234-.23-.393-.249q-.081-.01-.162-.016a3 3 0 0 0-.403.004z"/></svg></a>
        </div>
      </div>
      <div class="col-6 col-md-2">
        <p class="fw-bold small mb-3">{navLabel}</p>
        <ul class="list-unstyled small">
          {navItems.map((item) => (
            <li class="mb-2"><a href={item.href} class="text-muted-kk text-decoration-none">{item.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="col-6 col-md-2">
        <p class="fw-bold small mb-3">{socialLabel}</p>
        <ul class="list-unstyled small">
          <li class="mb-2"><a href="#" class="text-muted-kk text-decoration-none">Instagram</a></li>
          <li class="mb-2"><a href="#" class="text-muted-kk text-decoration-none">LinkedIn</a></li>
          <li class="mb-2"><a href="#" class="text-muted-kk text-decoration-none">X</a></li>
        </ul>
      </div>
      <div class="col-6 col-md-2">
        <p class="fw-bold small mb-3">{contactLabel}</p>
        <p class="text-muted-kk small mb-0">WA: +62 812-3456-7890</p>
      </div>
    </div>

    <div class="footer-divider"><img src="/image/kukode-logo-transparent.png" alt="Kukode" /></div>

    <p class="text-muted-kk small text-center mb-0">{copyright}</p>
  </div>
</footer>

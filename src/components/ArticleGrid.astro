---
import type { ArticleRow, Locale } from '../lib/sheets';

interface Props {
  articles: ArticleRow[];
  locale: Locale;
}
const { articles, locale } = Astro.props;
const articleBasePath = locale === 'en' ? '/article' : '/id/article';
---

<div class="row g-3">
  <h2 class="visually-hidden">List of Article</h2>
  {articles.map((article) => (
    <div class="col-6 col-md-4">
      <div class="kk-card p-2">
        <a href={`${articleBasePath}/${article.slug}`} class="text-decoration-none text-reset d-block">
          <img src={article.featured_image || '/image/default-featured-image.jpg'} alt={article.title} class="img-fluid rounded-3 w-100 aspect-ratio-16-9 bg-light" style="min-height:100px;" />
          <div class="m-2">
            <time datetime={article.published_date} class="text-muted-kk small mb-1 d-block">
              {article.published_date}
            </time>
            <h3 class="h6 font-heading fw-bold mt-2">{article.title}</h3>
            <p class="text-muted-kk small">{article.excerpt}</p>
          </div>
        </a>
      </div>
    </div>
  ))}
</div>

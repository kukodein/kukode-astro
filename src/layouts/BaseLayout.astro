---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { getSettings, type Locale } from '../lib/sheets';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  path: string; // path halaman ini TANPA domain, contoh "/about/" atau "/id/tentang/"
  enPath?: string; // untuk hreflang — lihat SEO.astro
  idPath?: string; // untuk hreflang — lihat SEO.astro
  image?: string; // absolute URL og:image, kalau tidak diisi pakai fallback default
  type?: 'website' | 'article';
  publishedDate?: string;
  modifiedDate?: string;
  robots?: string; // opsional override manual — kalau tidak diisi, SEO.astro pakai default environment-aware (noindex otomatis di luar Production)
  breadcrumbItems?: { name: string; url?: string }[]; // diteruskan ke SEO untuk JSON-LD BreadcrumbList
}

const { 
  locale, 
  title, 
  description, 
  path, 
  enPath, 
  idPath, 
  image, 
  type, 
  publishedDate, 
  modifiedDate, 
  robots,
  breadcrumbItems,
} = Astro.props;

// Path untuk language switcher — path relatif TANPA domain (beda dari hreflang di SEO.astro
// yang butuh absolute URL). Fallback ke Home versi bahasa lain kalau halaman ini belum ada
// terjemahannya (enPath/idPath undefined) — opsi A yang disepakati, sederhana & aman.
function buildSwitchLangHref(): string {
  if (locale === 'en') {
    if (!idPath) return '/id/';
    return idPath === '/' ? '/id/' : `/id${idPath}`;
  }
  // locale === 'id' -> switch ke EN, enPath sudah tanpa prefix /id
  return enPath || '/';
}
const switchLangHref = buildSwitchLangHref();

// Google Analytics — opsional, dikontrol lewat .env. Kosongkan PUBLIC_GA_MEASUREMENT_ID
// untuk menonaktifkan total (tidak ada script GA yang di-load sama sekali, tidak ada
// dampak performa untuk situs yang belum mau pasang GA).
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;

// Organization schema — global, di semua halaman. Field sosial (instagram/facebook/dst)
// OPSIONAL di sheet Settings — kalau belum diisi, cuma tidak ikut di sameAs (bukan error).
const settings = await getSettings();
const siteUrl = Astro.site?.origin ?? 'https://kukode.com';
const socialLinks = [
  settings.instagram,
  settings.facebook,
  settings.x,
  settings.linkedin,
  settings.youtube,
  settings.tiktok,
].filter(Boolean);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: settings.site_name || 'Kukode',
  url: siteUrl,
  ...(settings.logo_url && { logo: settings.logo_url }),
  ...(socialLinks.length > 0 && { sameAs: socialLinks }),
};
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('kk-theme') || 'light';
        document.documentElement.setAttribute('data-bs-theme', saved);
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <SEO
      locale={locale}
      title={title}
      description={description}
      image={image}
      type={type}
      publishedDate={publishedDate}
      modifiedDate={modifiedDate}
      path={path}
      enPath={enPath}
      idPath={idPath}
      robots={robots}
      breadcrumbItems={breadcrumbItems}
    />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.png">

    <!-- Bootstrap CSS -->
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Custom Styles -->
    <link href="/css/kukode.css" rel="stylesheet" />

    <!-- Snippet Additional CSS Style -->
    <slot name="extra-head" />

    <JsonLd data={organizationSchema} />

    {gaMeasurementId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaMeasurementId);
        </script>
      </>
    )}

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Kukode Blog"
      href={locale === 'en' ? '/rss.xml' : '/id/rss.xml'}
    />
  </head>
  <body>
    <Header locale={locale} switchLangHref={switchLangHref} />

    <main class={`kk-template-${path === '/' || path === '/id/' ? 'home' : 'page'}`}>
      <slot />
    </main>

    <Footer locale={locale} />

    <!-- Bootstrap JS -->
    <script is:inline src="/vendor/bootstrap/js/bootstrap.min.js" defer></script>

    <!-- Custom Script Global -->
    <script is:inline src="/js/kukode-global.js" defer></script>

    <!-- Snippet Additional JS Script -->
    <slot name="extra-scripts" />
  </body>
</html>

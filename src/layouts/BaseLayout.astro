---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../lib/sheets';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  path: string; // path halaman ini TANPA domain, contoh "/about/" atau "/id/tentang/"
  enPath?: string; // untuk hreflang — lihat SEO.astro
  idPath?: string; // untuk hreflang — lihat SEO.astro
  image?: string; // absolute URL og:image, kalau tidak diisi pakai fallback default
  type?: 'website' | 'article';
  publishedDate?: string;
  modifiedDate?: string;
}

const { locale, title, description, path, enPath, idPath, image, type, publishedDate, modifiedDate } =
  Astro.props;

// Path untuk language switcher — path relatif TANPA domain (beda dari hreflang di SEO.astro
// yang butuh absolute URL). Fallback ke Home versi bahasa lain kalau halaman ini belum ada
// terjemahannya (enPath/idPath undefined) — opsi A yang disepakati, sederhana & aman.
function buildSwitchLangHref(): string {
  if (locale === 'en') {
    if (!idPath) return '/id/';
    return idPath === '/' ? '/id/' : `/id${idPath}`;
  }
  // locale === 'id' -> switch ke EN, enPath sudah tanpa prefix /id
  return enPath || '/';
}
const switchLangHref = buildSwitchLangHref();
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <!-- Set tema SEBELUM apa pun dirender, supaya tidak ada "flash" light->dark.
         Harus inline (bukan file eksternal) dan di posisi paling atas <head>. -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('kk-theme') || 'light';
        document.documentElement.setAttribute('data-bs-theme', saved);
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <SEO
      locale={locale}
      title={title}
      description={description}
      image={image}
      type={type}
      publishedDate={publishedDate}
      modifiedDate={modifiedDate}
      path={path}
      enPath={enPath}
      idPath={idPath}
    />


    <!-- For modern browsers supporting PNG favicons -->
    <link rel="icon" type="image/png" href="/favicon.png">
    
    <!-- Legacy backup for older environments (optional) -->
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.png">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Bootstrap divendorkan lokal di public/vendor — bukan CDN, sesuai permintaan -->
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Custom styles Kukode — di-extract dari <style> inline jadi file terpisah -->
    <link href="/css/kukode.css" rel="stylesheet" />

    <!-- Slot untuk aset tambahan yang cuma dipakai halaman tertentu (mis. Swiper CSS di homepage) -->
    <slot name="extra-head" />
  </head>
  <body>
    <Header locale={locale} switchLangHref={switchLangHref} />

    <main class={`kk-template-${path === '/' || path === '/id/' ? 'home' : 'page'}`}>
      <slot />
    </main>

    <Footer locale={locale} />

    <!-- Bootstrap JS — divendorkan lokal -->
    <script is:inline src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Script global: navbar scroll effect + dark mode toggle (tombol ada di header, jadi perlu jalan di SEMUA halaman) -->
    <script is:inline src="/js/kukode-global.js"></script>

    <!-- Slot untuk script tambahan yang cuma dipakai halaman tertentu (mis. Swiper init + FAQ di homepage) -->
    <slot name="extra-scripts" />
  </body>
</html>

---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../lib/sheets';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  path: string; // path halaman ini TANPA domain, contoh "/about/" atau "/id/tentang/"
  enPath?: string; // untuk hreflang — lihat SEO.astro
  idPath?: string; // untuk hreflang — lihat SEO.astro
  image?: string; // absolute URL og:image, kalau tidak diisi pakai fallback default
  type?: 'website' | 'article';
  publishedDate?: string;
  modifiedDate?: string;
}

const { locale, title, description, path, enPath, idPath, image, type, publishedDate, modifiedDate } =
  Astro.props;
---

<!DOCTYPE html>
<html lang={locale} data-bs-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <SEO
      locale={locale}
      title={title}
      description={description}
      image={image}
      type={type}
      publishedDate={publishedDate}
      modifiedDate={modifiedDate}
      path={path}
      enPath={enPath}
      idPath={idPath}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Bootstrap divendorkan lokal di public/vendor — bukan CDN, sesuai permintaan -->
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Custom styles Kukode — di-extract dari <style> inline jadi file terpisah -->
    <link href="/css/kukode.css" rel="stylesheet" />

    <!-- Slot untuk aset tambahan yang cuma dipakai halaman tertentu (mis. Swiper CSS di homepage) -->
    <slot name="extra-head" />
  </head>
  <body>
    <Header locale={locale} />

    <main class={`kk-template-${path === '/' || path === '/id/' ? 'home' : 'page'}`}>
      <slot />
    </main>

    <Footer locale={locale} />

    <!-- Bootstrap JS — divendorkan lokal -->
    <script is:inline src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Script global: navbar scroll effect + dark mode toggle (tombol ada di header, jadi perlu jalan di SEMUA halaman) -->
    <script is:inline src="/js/kukode-global.js"></script>

    <!-- Slot untuk script tambahan yang cuma dipakai halaman tertentu (mis. Swiper init + FAQ di homepage) -->
    <slot name="extra-scripts" />
  </body>
</html>

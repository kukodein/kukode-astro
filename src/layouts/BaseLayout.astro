---
import { getSettings, getNavigation, type Locale } from '../lib/sheets';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  // Path versi EN halaman ini, TANPA domain, TANPA prefix (mis. "/article/foo", "/", "/about/").
  // Path versi ID halaman ini, TANPA domain, TANPA prefix "/id" (layout yang menambahkan prefix-nya).
  // Untuk halaman statis (Home/About) kedua path ini biasanya sama isinya.
  // Untuk artikel, slug EN dan ID bisa berbeda -> isi masing-masing sesuai slug aslinya.
  // Kalau salah satu belum ada terjemahannya, biarkan undefined -> hreflang untuk locale itu tidak di-render.
  enPath?: string;
  idPath?: string;
}

const { locale, title, description, enPath, idPath } = Astro.props;

// Fetch dijalankan saat build (SSG) — bukan di browser.
const settings = await getSettings();
const headerNav = await getNavigation(locale, 'header');
const footerNav = await getNavigation(locale, 'footer');

function localizedHref(url: string): string {
  if (locale === 'en') return url;
  if (url === '/') return '/id/';
  return `/id${url}`;
}

// Bangun absolute URL untuk hreflang (Google mensyaratkan absolute URL, bukan relative).
const siteUrl = Astro.site?.origin ?? 'https://domain.com';
function absoluteEnUrl(p: string): string {
  return `${siteUrl}${p}`;
}
function absoluteIdUrl(p: string): string {
  return p === '/' ? `${siteUrl}/id/` : `${siteUrl}/id${p}`;
}
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={settings.favicon_url} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    {enPath && <link rel="alternate" hreflang="en" href={absoluteEnUrl(enPath)} />}
    {idPath && <link rel="alternate" hreflang="id" href={absoluteIdUrl(idPath)} />}
    {enPath && <link rel="alternate" hreflang="x-default" href={absoluteEnUrl(enPath)} />}

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="d-flex flex-column min-vh-100">
    <header class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
      <div class="container">
        <a class="navbar-brand" href={localizedHref('/')}>
          {settings.logo_url
            ? <img src={settings.logo_url} alt={settings.site_name} height="32" />
            : settings.site_name}
        </a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#mainNav"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
          <ul class="navbar-nav ms-auto">
            {headerNav.map((item) => (
              <li class="nav-item">
                <a class="nav-link" href={localizedHref(item.url)}>{item.label}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </header>

    <main class="container flex-grow-1 py-4">
      <slot />
    </main>

    <footer class="bg-light border-top mt-auto py-2">
      <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center">
        <ul class="nav mb-2 mb-md-0">
          {footerNav.map((item) => (
            <li class="nav-item">
              <a class="nav-link px-2 text-muted" href={localizedHref(item.url)}>{item.label}</a>
            </li>
          ))}
        </ul>
        <p class="text-muted mb-0">{settings.copyright_text}</p>
      </div>
    </footer>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>
  </body>
</html>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAuthors } from '../../lib/sheets';

const authors = await getAuthors();
---

<BaseLayout locale="en" title="Authors" description="Browse articles by author" enPath="/author/" idPath="/author/" path="/author/">
  <div class="container py-5">
    <h1 class="mb-4">Authors</h1>
    <div class="row g-3">
      {authors.map((author) => (
        <div class="col-md-4">
          <a href={`/author/${author.slug_en}/`} class="kk-card d-block p-4 text-decoration-none text-reset">
            <h2 class="h6 font-heading fw-bold mb-0">{author.name_en}</h2>
          </a>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

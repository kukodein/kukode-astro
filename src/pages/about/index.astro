---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPageData } from '../../lib/sheets';

const page = await getPageData('en', 'about');
---

<BaseLayout
  locale="en"
  title={page.meta_title || page.title}
  description={page.meta_description}
  enPath="/about/" idPath="/about/"
>
  <h1>{page.title}</h1>
  <p>{page.description}</p>
</BaseLayout>

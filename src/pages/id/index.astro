---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPageFields } from '../../lib/sheets';

// CATATAN: Home versi ID ini masih pakai template sederhana lama (belum di-redesign
// menyusul versi EN yang sudah full custom section) — gap yang sudah tercatat
// sebelumnya, di luar scope perubahan sistem Pages kali ini.
const homeFields = await getPageFields('home');
const title = homeFields?.title_id || 'Kukode';
const description = homeFields?.meta_description_id || '';
const metaTitle = homeFields?.meta_title_id || title;
const image = homeFields?.featured_image;
---

<BaseLayout
  locale="id"
  title={metaTitle}
  description={description}
  image={image}
  enPath="/" idPath="/"
  path="/id/"
>
  <div class="container py-5">
    <h1>{title}</h1>
    <p>{description}</p>
  </div>
</BaseLayout>

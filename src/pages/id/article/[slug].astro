---
import { marked } from 'marked';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getArticles, getArticleAlternateSlug } from '../../../lib/sheets';

export async function getStaticPaths() {
  const articles = await getArticles('id');
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const bodyHtml = await marked.parse(article.body);

// Cari padanan slug versi EN lewat article_id.
const alternateSlugEn = await getArticleAlternateSlug(article.article_id, 'en');
---

<BaseLayout
  locale="id"
  title={article.meta_title || article.title}
  description={article.meta_description || article.excerpt}
  enPath={alternateSlugEn ? `/article/${alternateSlugEn}` : undefined}
  idPath={`/article/${article.slug}`}
  path={`/id/article/${article.slug}`}
  image={article.featured_image}
  type="article"
  publishedDate={article.published_date}
  modifiedDate={article.date_modified}
>
  <article class="container py-5">
    <div class="row">
      <div class="col-lg-8 mx-auto">
        <h1>{article.title}</h1>
        <time datetime={article.published_date} class="text-muted d-block mb-3">{article.published_date}</time>
        {article.featured_image && <img src={article.featured_image} alt={article.title} class="img-fluid rounded-1 mb-3" />}
        <div class="article-body" set:html={bodyHtml} />
      </div>
    </div>
  </article>
</BaseLayout>

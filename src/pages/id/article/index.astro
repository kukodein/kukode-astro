---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getArticles } from '../../../lib/sheets';

const articles = await getArticles('id');
---

<BaseLayout locale="id" title="Artikel" description="Artikel terbaru" enPath="/article/" idPath="/article/" path="/id/article/">
  <h1>Artikel</h1>
  <ul class="article-list">
    {articles.map((article) => (
      <li>
        <a href={`/id/article/${article.slug}`}>
          {article.featured_image && <img src={article.featured_image} alt={article.title} />}
          <h2>{article.title}</h2>
          <p>{article.excerpt}</p>
          <time datetime={article.published_date}>{article.published_date}</time>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

---
import { marked } from 'marked';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SimpleTemplate from '../../components/templates/SimpleTemplate.astro';
import SimpleWideTemplate from '../../components/templates/SimpleWideTemplate.astro';
import SimpleBlankTemplate from '../../components/templates/SimpleBlankTemplate.astro';
import AboutTemplate from '../../components/templates/AboutTemplate.astro';
import ServiceTemplate from '../../components/templates/ServiceTemplate.astro';
import ContactTemplate from '../../components/templates/ContactTemplate.astro';
import { getPages, getPageAlternateSlug, truncateForMeta } from '../../lib/sheets';

export async function getStaticPaths() {
  const pages = await getPages('id');
  return pages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const bodyHtml = page.body ? await marked.parse(page.body) : '';
const alternateSlugEn = await getPageAlternateSlug(page.page_id, 'en');
---

<BaseLayout
  locale="id"
  title={page.meta_title || page.title}
  description={page.meta_description || (page.body ? truncateForMeta(page.body) : undefined)}
  enPath={alternateSlugEn ? `/${alternateSlugEn}/` : undefined}
  idPath={`/${page.slug}/`}
  path={`/id/${page.slug}/`}
  image={page.featured_image}
>
  {page.template === 'about' && (
    <AboutTemplate locale="id" title={page.title} bodyHtml={bodyHtml} featuredImage={page.featured_image} />
  )}
  {page.template === 'contact' && (
    <ContactTemplate
      locale="id"
      title={page.title}
      bodyHtml={bodyHtml}
      address={page.address}
      email={page.email}
      hours={page.hours}
    />
  )}
  {page.template === 'service' && (
    <ServiceTemplate
      locale="id"
      title={page.title}
      bodyHtml={bodyHtml}
      featuredImage={page.featured_image}
      icon={page.icon}
      priceFrom={page.price_from}
    />
  )}
  {page.template === 'simple' && (
    <SimpleTemplate title={page.title} bodyHtml={bodyHtml} featuredImage={page.featured_image} />
  )}
  {page.template === 'simple_wide' && (
    <SimpleWideTemplate title={page.title} bodyHtml={bodyHtml} featuredImage={page.featured_image} />
  )}
  {page.template === 'simple_blank' && (
    <SimpleBlankTemplate title={page.title} bodyHtml={bodyHtml} featuredImage={page.featured_image} />
  )}
</BaseLayout>

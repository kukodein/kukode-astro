---
import { marked } from 'marked';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArticles, getArticleAlternateSlug } from '../../lib/sheets';

export async function getStaticPaths() {
  const articles = await getArticles('en');
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const bodyHtml = marked.parse(article.body);

// Cari padanan slug versi ID lewat article_id (bukan lewat slug, karena slug boleh beda per bahasa).
// Bisa null kalau artikel ini belum diterjemahkan -> hreflang untuk id tidak akan dirender.
const alternateSlugId = await getArticleAlternateSlug(article.article_id, 'id');
---

<BaseLayout
  locale="en"
  title={article.meta_title || article.title}
  description={article.meta_description || article.excerpt}
  enPath={`/article/${article.slug}`}
  idPath={alternateSlugId ? `/article/${alternateSlugId}` : undefined}
  path={`/article/${article.slug}`}
  image={article.featured_image}
  type="article"
  publishedDate={article.published_date}
  modifiedDate={article.date_modified}
>
  <article class="container py-5">
    <div class="row">
      <div class="col-lg-8 mx-auto">
        <h1>{article.title}</h1>
        <time datetime={article.published_date} class="text-muted d-block mb-3">{article.published_date}</time>
        {article.featured_image && <img src={article.featured_image} alt={article.title} class="img-fluid rounded-1 mb-3" />}
        <div class="article-body" set:html={bodyHtml} />
      </div>
    </div>
  </article>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pagination from '../../components/Pagination.astro';
import { getPortfolioItems } from '../../lib/sheets';

const PAGE_SIZE = 12;
const allItems = await getPortfolioItems();
const lastPage = Math.max(1, Math.ceil(allItems.length / PAGE_SIZE));
const items = allItems.slice(0, PAGE_SIZE);
---

<BaseLayout
  locale="en"
  title="Portfolio"
  description="Recent web development projects by Kukode"
  enPath="/portfolio/"
  path="/portfolio/"
>
  <div class="container py-5">
    <h1 class="mb-4">Portfolio</h1>
    <div class="row g-4">
      <h2 class="visually-hidden">List of Portfolio</h2>
      {items.map((item) => (
        <div class="col-md-6 col-lg-4">
          <a href={`/portfolio/${item.slug}/`} class="kk-portfolio-card text-decoration-none text-reset d-block">
            <div class="kk-browser-frame">
              <div class="kk-browser-bar"><span></span><span></span><span></span></div>
              <div class="kk-browser-body">
                <img src={item.featured_image || '/image/default-featured-image.jpg'} alt={item.title} style="min-height:100px;" />
                <div class="kk-overlay"><span class="btn btn-light btn-sm rounded-pill">View project</span></div>
              </div>
            </div>
            <div class="m-2">
              <p class="text-muted-kk small mb-1">Company Profile &bull; 2025</p>
              <h3 class="h6 font-heading fw-bold">{item.title}</h3>
            </div>
          </a>
        </div>
      ))}
    </div>
    <Pagination currentPage={1} lastPage={lastPage} basePath="/portfolio" />
  </div>
</BaseLayout>

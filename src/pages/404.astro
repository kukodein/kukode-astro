---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSettings } from '../lib/sheets';

const settings = await getSettings();
---

<BaseLayout
  locale="en"
  title="404 Not Found"
  description="Sorry, the page you're looking for doesn't exist."
  enPath="" idPath=""
  path=""
>
  <div class="kk-hero flex-grow-1 d-flex align-items-center justify-content-center flex-column min-vh-100">
    <div class="kk-hero-content text-center py-5"><h1 class="display-4">404</h1><p class="lead mb-5">Sorry, the page you're looking for doesn't exist.</p>
      <div class="d-flex gap-2 justify-content-center"><a href="/" class="btn btn-primary">Home</a>
      </div>
    </div>
  </div>
</BaseLayout>


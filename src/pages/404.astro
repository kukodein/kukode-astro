---
import { getSettings } from '../lib/sheets';

const settings = await getSettings();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={settings.favicon_url} />
    <title>Page Not Found / Halaman Tidak Ditemukan</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="d-flex flex-column min-vh-100">
    <main class="container flex-grow-1 d-flex align-items-center justify-content-center">
      <div class="text-center py-5">
        <h1 class="display-4">404</h1>
        <p class="lead mb-1">Sorry, the page you're looking for doesn't exist.</p>
        <p class="lead mb-4">Maaf, halaman yang Anda cari tidak ditemukan.</p>
        <div class="d-flex gap-2 justify-content-center">
          <a href="/" class="btn btn-primary">Home (EN)</a>
          <a href="/id/" class="btn btn-outline-primary">Beranda (ID)</a>
        </div>
      </div>
    </main>
  </body>
</html>

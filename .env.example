# Copy file ini jadi ".env" (tanpa .example), lalu isi nilai aslinya.
# ".env" sudah di-gitignore — aman, tidak akan ke-overwrite oleh update kode dari Claude,
# dan tidak akan ke-commit ke Git.

# ---------- Google Sheets ----------
# Kosongkan untuk staging (No Header X Rbot & meta robot noindex)
# Isikan "production" untuk bisa diindex Mesin Pencarian (Google)
VERCEL_ENV=

# ---------- Google Sheets ----------
# Spreadsheet ID diambil dari URL:
# https://docs.google.com/spreadsheets/d/**INI_SPREADSHEET_ID**/edit
PUBLIC_SPREADSHEET_ID=

# Tiap tab/sheet punya "gid" unik — lihat di URL saat tab itu aktif (...#gid=123456)
PUBLIC_SHEET_GID_PAGES=
PUBLIC_SHEET_GID_ARTICLES_EN=
PUBLIC_SHEET_GID_ARTICLES_ID=
PUBLIC_SHEET_GID_NAVIGATION_EN=
PUBLIC_SHEET_GID_NAVIGATION_ID=
PUBLIC_SHEET_GID_SETTINGS=
PUBLIC_SHEET_GID_CATEGORIES=
PUBLIC_SHEET_GID_PORTFOLIO=

# ---------- Site ----------
# Domain asli Anda, TANPA trailing slash. Dipakai untuk sitemap, canonical URL, hreflang.
PUBLIC_SITE_URL=https://kukode.com

# ---------- Analytics (opsional) ----------
# Kosongkan untuk menonaktifkan Google Analytics sepenuhnya (tidak ada script GA yang di-load).
# Isi dengan Measurement ID GA4 Anda (format: G-XXXXXXXXXX) untuk mengaktifkan.
PUBLIC_GA_MEASUREMENT_ID=
